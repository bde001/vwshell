<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-оверлей VW-логотипа: полноэкранный чёрный слой поверх домашнего экрана.
     Показывается только при холодном старте процесса (guard в MainActivity),
     затем плавно скрывается (fade). Не является отдельной activity — HOME-фильтр не дублируется. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:contentDescription="@string/splash_logo_desc"
        android:src="@drawable/ic_vw_logo" />
</FrameLayout>
