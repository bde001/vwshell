<?xml version="1.0" encoding="utf-8"?>
<!-- Страница главного меню: фиксированная сетка 3x2 (6 слотов).
     Иконка сверху, подпись под иконкой (см. view_tile.xml / VWTile.kt). -->
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="3"
    android:rowCount="2"
    android:useDefaultMargins="false"
    android:alignmentMode="alignMargins">

    <com.vwshell.auto.widget.VWTile android:id="@+id/tileA" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    <com.vwshell.auto.widget.VWTile android:id="@+id/tileB" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    <com.vwshell.auto.widget.VWTile android:id="@+id/tileC" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    <com.vwshell.auto.widget.VWTile android:id="@+id/tileD" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    <com.vwshell.auto.widget.VWTile android:id="@+id/tileE" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
    <com.vwshell.auto.widget.VWTile android:id="@+id/tileF" style="@style/VW.Tile"
        android:layout_columnWeight="1" android:layout_rowWeight="1"/>
</GridLayout>
