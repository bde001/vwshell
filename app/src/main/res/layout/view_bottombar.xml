<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottombar_height"
    android:orientation="vertical"
    android:background="@color/vw_panel_bg">

    <!-- Строка состояния/источника -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:id="@+id/sourceIcon"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_media"
            android:contentDescription="@string/media_source"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/sourceText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/vw_text_secondary"
            android:textSize="@dimen/small_text"
            android:text="@string/source_none"/>

        <TextView
            android:id="@+id/climateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/vw_text_secondary"
            android:textSize="@dimen/small_text"
            android:visibility="gone"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/vw_divider"/>

    <!-- Навигационная строка разделов (индикатор текущего — красная линия через selected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout android:id="@+id/navHome" style="@style/VW.NavItem">
            <ImageView style="@style/VW.NavIcon" android:src="@drawable/ic_home"/>
            <TextView style="@style/VW.NavLabel" android:text="@string/home"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navRadio" style="@style/VW.NavItem">
            <ImageView style="@style/VW.NavIcon" android:src="@drawable/ic_radio"/>
            <TextView style="@style/VW.NavLabel" android:text="@string/tile_radio"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navMedia" style="@style/VW.NavItem">
            <ImageView style="@style/VW.NavIcon" android:src="@drawable/ic_media"/>
            <TextView style="@style/VW.NavLabel" android:text="@string/tile_media"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navApps" style="@style/VW.NavItem">
            <ImageView style="@style/VW.NavIcon" android:src="@drawable/ic_apps"/>
            <TextView style="@style/VW.NavLabel" android:text="@string/apps_title"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" style="@style/VW.NavItem">
            <ImageView style="@style/VW.NavIcon" android:src="@drawable/ic_settings"/>
            <TextView style="@style/VW.NavLabel" android:text="@string/tile_settings"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
