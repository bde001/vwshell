<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/vw_background">
    <include layout="@layout/layout_section_header"/>
    <View android:layout_width="match_parent" android:layout_height="@dimen/accent_line" android:background="@drawable/accent_line"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5" android:orientation="vertical" android:padding="@dimen/screen_padding">
            <TextView android:id="@+id/btStatus" style="@style/VW.TextSecondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBtSettings" style="@style/VW.Button"
                android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="12dp"
                android:text="@string/phone_bt_connect" app:icon="@drawable/ic_bluetooth" app:iconGravity="textStart" app:iconTint="@color/vw_icon_tint"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDialpad" style="@style/VW.Button"
                android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="10dp"
                android:text="@string/phone_open_dialpad" app:icon="@drawable/ic_dialpad" app:iconGravity="textStart" app:iconTint="@color/vw_icon_tint"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCallLog" style="@style/VW.Button"
                android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="10dp"
                android:text="@string/phone_call_log" app:icon="@drawable/ic_call_log" app:iconGravity="textStart" app:iconTint="@color/vw_icon_tint"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnContacts" style="@style/VW.Button"
                android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="10dp"
                android:text="@string/phone_contacts" app:icon="@drawable/ic_contacts" app:iconGravity="textStart" app:iconTint="@color/vw_icon_tint"/>
            <TextView android:id="@+id/phoneNote" style="@style/VW.TextSecondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/phone_perm_needed"/>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/divider_h"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:orientation="vertical">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/phoneList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/phoneEmpty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:visibility="gone"
                android:textColor="@color/vw_text_secondary" android:textSize="@dimen/body_text" android:padding="24dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
