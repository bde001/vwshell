<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Сама плитка с градиентным фоном -->
    <FrameLayout
        android:id="@+id/tileCard"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/tile_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            app:tint="#e8eaed" />

        <View
            android:id="@+id/tileUnderline"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@drawable/stripe_bottom_glow" />
    </FrameLayout>

    <!-- Надпись СТРОГО ПОД плиткой -->
    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:letterSpacing="0.15"
        android:shadowColor="#FF1A1A"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="#e8eaed"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
