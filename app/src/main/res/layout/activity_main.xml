<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vw_background"
    android:fitsSystemWindows="false">

    <!-- Домашний экран: верхняя панель + две листаемые страницы 3x2 + индикатор из двух кружков -->
    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель (часы слева, статус справа; без надписи «Режим автомобиля») -->
        <include android:id="@+id/topBar" layout="@layout/view_topbar"/>

        <!-- Две страницы главного меню, горизонтальный свайп -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Индикатор страниц: ровно два кружка, активный — красный -->
        <LinearLayout
            android:id="@+id/pageDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <View android:id="@+id/dot0"
                android:layout_width="8dp" android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/page_dot_active"/>
            <View android:id="@+id/dot1"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/page_dot_inactive"/>
        </LinearLayout>

        <!-- Мини-плеер: виден только при реальной активной медиасессии -->
        <include android:id="@+id/miniPlayer" layout="@layout/view_mini_player"/>
    </LinearLayout>

    <!-- Контейнер разделов -->
    <FrameLayout
        android:id="@+id/sectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vw_background"
        android:visibility="gone"/>
</FrameLayout>
