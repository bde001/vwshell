<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vw_background"
    android:fitsSystemWindows="false">

    <!-- Домашний экран -->
    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель -->
        <include android:id="@+id/topBar" layout="@layout/view_topbar"/>
        <View android:layout_width="match_parent" android:layout_height="@dimen/accent_line" android:background="@drawable/accent_line"/>

        <!-- Сетка плиток 3x2 -->
        <GridLayout
            android:id="@+id/tileGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="@dimen/screen_padding"
            android:columnCount="3"
            android:rowCount="2">

            <com.vwshell.auto.widget.VWTile android:id="@+id/tileRadio"   style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
            <com.vwshell.auto.widget.VWTile android:id="@+id/tileMedia"   style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
            <com.vwshell.auto.widget.VWTile android:id="@+id/tilePhone"   style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
            <com.vwshell.auto.widget.VWTile android:id="@+id/tileNav"     style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
            <com.vwshell.auto.widget.VWTile android:id="@+id/tileVehicle" style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
            <com.vwshell.auto.widget.VWTile android:id="@+id/tileSettings" style="@style/VW.Tile" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        </GridLayout>

        <!-- Тонкий красный разделитель -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/accent_line" android:alpha="0.85"/>

        <!-- Нижняя информационная панель -->
        <include android:id="@+id/bottomBar" layout="@layout/view_bottombar"/>
    </LinearLayout>

    <!-- Контейнер разделов -->
    <FrameLayout
        android:id="@+id/sectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vw_background"
        android:visibility="gone" />
</FrameLayout>
