<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_screen_gradient">

    <include layout="@layout/layout_section_header"/>

    <!-- Верхняя строка режима: ‹ | частота (по центру) | › — без температуры -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btnRadioPrev" android:layout_width="60dp" android:layout_height="60dp"
            android:background="@drawable/btn_radio_nav_bg" android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside" android:padding="12dp"
            android:contentDescription="@string/radio_prev" app:tint="@color/vw_text_primary"/>
        <TextView android:id="@+id/radioFreq" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="sans-serif-medium" android:gravity="center"
            android:letterSpacing="0.1" android:text="--.-"
            android:textColor="@color/vw_text_primary" android:textSize="32sp"/>
        <ImageButton android:id="@+id/btnRadioNext" android:layout_width="60dp" android:layout_height="60dp"
            android:background="@drawable/btn_radio_nav_bg" android:src="@drawable/ic_arrow_back"
            android:rotation="180" android:scaleType="centerInside" android:padding="12dp"
            android:contentDescription="@string/radio_next" app:tint="@color/vw_text_primary"/>
    </LinearLayout>

    <!-- Центральная зона: исполнитель/трек слева, квадратный арт станции справа; список пресетов ниже -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:paddingEnd="20dp">
                <TextView android:id="@+id/radioStationName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="2"
                    android:textColor="@color/vw_text_primary" android:textSize="22sp"/>
                <TextView android:id="@+id/radioBand" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/radio_band_fm"
                    android:textColor="@color/vw_text_secondary" android:textSize="16sp"/>
                <TextView android:id="@+id/radioStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/radio_no_tuner"
                    android:textColor="@color/vw_text_secondary" android:textSize="@dimen/small_text"/>
            </LinearLayout>
            <FrameLayout android:layout_width="180dp" android:layout_height="180dp">
                <TextView android:id="@+id/radioArt" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#FFFFFF" android:gravity="center" android:text="FM"
                    android:textColor="#111111" android:textSize="48sp" android:textStyle="bold"/>
                <ImageButton android:id="@+id/btnFav" android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_gravity="top|end" android:layout_margin="4dp"
                    android:background="@drawable/btn_radio_nav_bg" android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/radio_favorites" app:tint="@color/vw_text_primary"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Прокручиваемый список реально сохранённых пресетов -->
        <TextView style="@style/VW.SectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/radio_frequency"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/stationList"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingBottom="8dp"/>
            <TextView android:id="@+id/stationsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:padding="24dp"
                android:textColor="@color/vw_text_secondary" android:textSize="@dimen/body_text"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Нижняя панель режимов: 6 слитных кнопок, border-top 2dp #FF1A1A, SVG-иконки -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="90dp"
        android:background="@drawable/bg_radio_panel" android:orientation="horizontal" android:weightSum="6">
        <LinearLayout android:id="@+id/modeSource" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_source" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Источник" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/modeStation" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_list" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Станция" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/modeMemory" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_memory" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Память" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/modePreset" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_preset" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Пресеты" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/modeManual" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_manual" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Вручную" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/modeSettings" style="@style/VW.RadioModeButton">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_radio_settings" android:contentDescription="@null" app:tint="@color/vw_text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Настройки" android:textSize="12sp" android:textColor="@color/vw_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
