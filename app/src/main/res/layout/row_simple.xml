<?xml version="1.0" encoding="utf-8"?>
<!-- Универсальная строка списка в стиле Discover Pro: заголовок, подзаголовок, красная метка выбора -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/vw_text_primary"
            android:textSize="@dimen/body_text"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/rowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/vw_text_secondary"
            android:textSize="@dimen/small_text"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:visibility="gone"
        app:tint="@color/vw_accent"/>
</LinearLayout>
