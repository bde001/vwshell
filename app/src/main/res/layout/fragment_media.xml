<?xml version="1.0" encoding="utf-8"?>
<!-- Единый экран плеера: слева — текущий трек и управление, справа — прокручиваемый список. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_screen_gradient">
    <include layout="@layout/layout_section_header"/>

    <!-- Индикатор выбранного источника (локальный / внешняя медиасессия) + переключатель -->
    <LinearLayout android:id="@+id/sourceBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="6dp" android:paddingBottom="6dp">

        <ImageView android:id="@+id/sourceIcon" android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_media"
            android:contentDescription="@string/media_source" android:tint="@color/vw_text_secondary"/>

        <TextView android:id="@+id/sourceLabel" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/vw_text_primary" android:textSize="@dimen/body_text"
            android:text="@string/media_local_title"/>

        <ImageButton android:id="@+id/btnSwitchSource" style="@style/VW.ControlButton.small"
            android:src="@drawable/ic_bluetooth" android:contentDescription="@string/media_switch_source"/>

        <!-- Компактная пиктограмма обновления списка — рядом с кнопкой источника -->
        <ImageButton android:id="@+id/btnRescanIcon" style="@style/VW.ControlButton.small"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_refresh_small" android:contentDescription="@string/media_rescan"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false">

        <!-- Крайняя левая узкая колонка: ВЕРТИКАЛЬНЫЙ регулятор громкости локального плеера -->
        <FrameLayout android:id="@+id/volumeColumn"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:paddingStart="6dp" android:paddingEnd="2dp">
            <SeekBar
                android:id="@+id/volumeSeekVertical"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:max="100"
                android:progressTint="@color/vw_accent"
                android:thumbTint="#FFFFFF"
                android:rotation="270"
                android:contentDescription="@string/media_volume"/>
        </FrameLayout>

        <!-- Левая колонка: обложка, название, исполнитель, основные элементы управления -->
        <ScrollView android:id="@+id/nowPlayingPanel"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:padding="@dimen/screen_padding">

                <ImageView android:id="@+id/npArt"
                    android:layout_width="170dp" android:layout_height="170dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_album_art"
                    android:src="@drawable/ic_album"
                    android:contentDescription="@string/media_local_title"/>

                <TextView android:id="@+id/npTrack" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center" android:singleLine="true" android:ellipsize="end"
                    android:textColor="@color/vw_text_primary" android:textSize="24sp"/>
                <TextView android:id="@+id/npArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="center" android:singleLine="true" android:ellipsize="end"
                    android:textColor="@color/vw_text_secondary" android:textSize="@dimen/title_text"/>

                <!-- Реальный прогресс воспроизведения -->
                <SeekBar android:id="@+id/npSeek" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:progressTint="@color/vw_accent"
                    android:thumbTint="#FFFFFF" android:enabled="false"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/npPos" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="@color/vw_text_disabled" android:textSize="@dimen/small_text" android:text="0:00"/>
                    <TextView android:id="@+id/npDur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/vw_text_disabled" android:textSize="@dimen/small_text" android:text="0:00"/>
                </LinearLayout>

                <!-- Время трека: текущее/общее — по центру -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
                    <TextView android:id="@+id/npPosCenter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/vw_text_secondary" android:textSize="@dimen/body_text" android:text="0:00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                        android:textColor="@color/vw_text_disabled" android:textSize="@dimen/body_text" android:text="/"/>
                    <TextView android:id="@+id/npDurCenter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/vw_text_secondary" android:textSize="@dimen/body_text" android:text="0:00"/>
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp">
                    <ImageButton android:id="@+id/btnPrev" style="@style/VW.ControlButton"
                        android:src="@drawable/ic_prev" android:contentDescription="@string/media_prev" android:alpha="0.35"/>
                    <ImageButton android:id="@+id/btnPlay" style="@style/VW.ControlButton.play"
                        android:src="@drawable/ic_play" android:contentDescription="@string/media_play" android:alpha="0.35"/>
                    <ImageButton android:id="@+id/btnNext" style="@style/VW.ControlButton"
                        android:src="@drawable/ic_next" android:contentDescription="@string/media_next" android:alpha="0.35"/>
                </LinearLayout>

                <!-- Нижняя текстовая строка статуса убрана; горизонтальная громкость заменена вертикальной слева -->
                <View android:id="@+id/playerStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
                <SeekBar android:id="@+id/volumeSeek" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

                
            </LinearLayout>
        </ScrollView>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/vw_divider"/>

        <!-- Правая колонка: прокручиваемый список треков / плейлист -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4"
            android:orientation="vertical" android:padding="@dimen/screen_padding">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.12" android:textAllCaps="true"
                android:textColor="#FF1A1A" android:textSize="@dimen/small_text"
                android:text="@string/media_playlist"/>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="8dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/trackList"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:fadeScrollbars="false"/>
                <TextView android:id="@+id/playlistEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:padding="16dp"
                    android:textColor="@color/vw_text_secondary" android:textSize="@dimen/body_text"
                    android:text="@string/media_local_empty" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
