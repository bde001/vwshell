<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Строгая OEM-тема: без Material You, без динамических цветов, без теней -->
    <style name="Theme.VWShell" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/vw_background</item>
        <item name="colorPrimary">@color/vw_accent</item>
        <item name="colorPrimaryDark">@color/vw_background</item>
        <item name="colorAccent">@color/vw_accent</item>
        <item name="colorSurface">@color/vw_tile_bg</item>
        <item name="colorOnSurface">@color/vw_text_primary</item>
        <item name="android:windowBackground">@color/vw_background</item>
        <item name="android:navigationBarColor">@color/vw_background</item>
        <item name="android:statusBarColor">@color/vw_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/vw_text_primary</item>
        <item name="android:textColorSecondary">@color/vw_text_secondary</item>
        <item name="materialButtonStyle">@style/VW.Button</item>
        <item name="android:windowAnimationStyle">@style/VW.WindowAnim</item>
    </style>

    <style name="VW.WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/vw_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/vw_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/vw_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/vw_exit</item>
    </style>

    <style name="VW.TextTitle" parent="">
        <item name="android:textColor">@color/vw_text_primary</item>
        <item name="android:textSize">@dimen/header_text</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="VW.TextBody" parent="">
        <item name="android:textColor">@color/vw_text_primary</item>
        <item name="android:textSize">@dimen/body_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="VW.TextSecondary" parent="">
        <item name="android:textColor">@color/vw_text_secondary</item>
        <item name="android:textSize">@dimen/small_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="VW.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/vw_text_primary</item>
        <item name="backgroundTint">@color/vw_tile_bg</item>
        <item name="cornerRadius">@dimen/tile_radius</item>
        <item name="strokeColor">@color/vw_stroke</item>
        <item name="strokeWidth">@dimen/tile_stroke</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/vw_tile_bg_pressed</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="VW.Button.Accent" parent="VW.Button">
        <item name="backgroundTint">@color/vw_accent</item>
        <item name="strokeColor">@color/vw_accent</item>
        <item name="android:textColor">@color/vw_text_primary</item>
    </style>

    <style name="VW.SectionLabel" parent="">
        <item name="android:textColor">@color/vw_text_secondary</item>
        <item name="android:textSize">@dimen/small_text</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="VW.ControlButton" parent="">
        <item name="android:layout_width">@dimen/control_button</item>
        <item name="android:layout_height">@dimen/control_button</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <!-- Круглая кнопка с градиентом VW (тот же набор цветов, что у плиток) -->
        <item name="android:background">@drawable/bg_control_round</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">14dp</item>
        <item name="tint">@color/vw_icon_tint</item>
        <item name="android:tint">@color/vw_icon_tint</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="VW.ControlButton.small">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="VW.ControlButton.play">
        <item name="android:layout_width">@dimen/dial_button</item>
        <item name="android:layout_height">@dimen/dial_button</item>
    </style>

    <style name="VW.SettingRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="VW.SettingIcon" parent="">
        <item name="android:layout_width">@dimen/icon_md</item>
        <item name="android:layout_height">@dimen/icon_md</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:tint">@color/vw_icon_tint</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="VW.SettingTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/vw_text_primary</item>
        <item name="android:textSize">@dimen/body_text</item>
    </style>

    <style name="VW.SettingValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/vw_text_secondary</item>
        <item name="android:textSize">@dimen/small_text</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxWidth">220dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="VW.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@drawable/divider_h</item>
    </style>
    <style name="VW.NavItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="VW.NavIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@drawable/selector_nav_item</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="VW.NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@drawable/selector_nav_item</item>
    </style>

    <!-- Пустая подготовленная ячейка сетки второй страницы (тонкая рамка, без контента) -->
    <style name="VW.TileSlot" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">@dimen/tile_gap</item>
        <item name="android:background">@drawable/bg_tile_slot</item>
    </style>

    <style name="VW.RadioModeButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_radio_mode</item>
    </style>

    <style name="VW.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">@dimen/tile_gap</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

</resources>
