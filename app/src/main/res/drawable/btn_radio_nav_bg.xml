<?xml version="1.0" encoding="utf-8"?>
<!-- Круглая кнопка ‹ › радио: прозрачный фон, рамка #2a313b; при нажатии — красная рамка + rgba(255,26,26,0.15) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#26FF1A1A"/>
            <stroke android:width="2dp" android:color="#FF1A1A"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#26FF1A1A"/>
            <stroke android:width="2dp" android:color="#FF1A1A"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="@color/vw_divider"/>
        </shape>
    </item>
</selector>
