<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон круглых кнопок управления плеера (40dp): градиент #3A0810 -> #1A0408 (35%) -> #000000,
  рамка vw_stroke; при нажатии/фокусе рамка становится акцентной.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/tile_grad_top" android:centerColor="@color/tile_grad_mid"
                android:centerX="0.35" android:endColor="@color/tile_grad_bottom"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="@color/vw_accent"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/tile_grad_top" android:centerColor="@color/tile_grad_mid"
                android:centerX="0.35" android:endColor="@color/tile_grad_bottom"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="@color/vw_accent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/tile_grad_top" android:centerColor="@color/tile_grad_mid"
                android:centerX="0.35" android:endColor="@color/tile_grad_bottom"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="@color/vw_stroke"/>
        </shape>
    </item>
</selector>
