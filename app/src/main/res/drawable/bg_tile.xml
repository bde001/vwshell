<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_tile_bg_pressed"/>
            <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
            <corners android:radius="@dimen/tile_radius"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_tile_bg"/>
            <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
            <corners android:radius="@dimen/tile_radius"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_tile_bg"/>
            <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
            <corners android:radius="@dimen/tile_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_tile_bg"/>
            <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_stroke"/>
            <corners android:radius="@dimen/tile_radius"/>
        </shape>
    </item>
</selector>
