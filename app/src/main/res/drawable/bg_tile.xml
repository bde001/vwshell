<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон плитки (VWTile) по образцу VW: вертикальный градиент #3A0810 -> #1A0408 (35%) -> #000000.
  Скругление/рамка — прежние. Pressed/focused/selected оставляют градиент, меняя рамку на акцентную.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:drawable="@drawable/bg_tile_gradient"/>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22FFFFFF"/>
                    <corners android:radius="@dimen/tile_radius"/>
                    <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/bg_tile_gradient"/>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="@dimen/tile_radius"/>
                    <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:drawable="@drawable/bg_tile_gradient"/>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <corners android:radius="@dimen/tile_radius"/>
                    <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_accent"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/bg_tile_gradient"/>
</selector>

