<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон плитки главного экрана по образцу VW: вертикальный градиент
  #3A0810 (верх) -> #1A0408 (35%) -> #000000 (50-100%), тонкая рамка, скругление как раньше.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="@color/tile_grad_top"
                        android:centerColor="@color/tile_grad_mid"
                        android:centerX="0.35"
                        android:endColor="@color/tile_grad_bottom" />
                    <corners android:radius="@dimen/tile_radius" />
                    <stroke android:width="@dimen/tile_stroke" android:color="@color/vw_stroke" />
                </shape>
    </item>
</layer-list>
